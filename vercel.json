{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://invoice-system-orpin-seven.vercel.app/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://invoice-system-orpin-seven.vercel.app/uploads/:path*"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "https://invoice-system-orpin-seven.vercel.app/socket.io/:path*"
    },
    {
      "source": "/((?!api|uploads|socket.io).*)",
      "destination": "/index.html"
    }
  ]
}
